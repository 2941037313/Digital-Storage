<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    ============ 3.0 → 4.0 兼容墓碑 ============
    用途：让 3.0 老存档读档时不刷「找不到 Def」。这些 Def **没有任何功能**，
    只是把 3.0 存档里存在的建筑 / 物品 / 植入体 / 研究 / 作业解析回来。

    ⚠️ 为什么不需要写桩类：ThingWithComps.ExposeData 是「按 Def 初始化 comps，
    再让每个 comp 各自读自己的数据」（ThingWithComps.cs:237 InitializeComps），
    不是按 Class 名匹配 ⇒ Def 没了，旧的 comp 数据被安静忽略，不报错。

    库存迁移（真正的数据保全）在 Source/Compatibility/Legacy30Migration.cs：
    3.0 的账本字段与键名在 Building_StorageCore 里用同键墓碑读回来，落进容器。
  -->

  <!-- 墓碑建筑基类：**故意不给 designationCategory** ⇒ 不进建造菜单（玩家不该再建这些） -->
  <ThingDef Name="DigitalStorage_LegacyBase" ParentName="BuildingBase" Abstract="True">
    <thingClass>Building</thingClass>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.5</fillPercent>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <minifiedDef>MinifiedThing</minifiedDef>
    <surfaceType>Item</surfaceType>
    <statBases>
      <Flammability>0.5</Flammability>
    </statBases>
    <comps>
      <li Class="CompProperties_Forbiddable" />
    </comps>
  </ThingDef>

  <!-- 3.0 的输入接口（4.0 砍掉）：读档时变成普通建筑，可拆除并退回材料 -->
  <ThingDef ParentName="DigitalStorage_LegacyBase">
    <defName>DigitalStorage_InputInterface</defName>
    <label>数字存储接口（3.0 遗留）</label>
    <description>3.0 的接口建筑。4.0 已移除该机制（核心本身就是完全体），这里只作为墓碑保留，没有功能。请拆除。</description>
    <graphicData>
      <texPath>2.0/基座</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <WorkToBuild>1000</WorkToBuild>
      <Mass>20</Mass>
    </statBases>
    <costList>
      <Steel>50</Steel>
      <Plasteel>25</Plasteel>
      <ComponentIndustrial>5</ComponentIndustrial>
    </costList>
  </ThingDef>

  <!-- 3.0 的缓冲仓库（4.0 砍掉） -->
  <ThingDef ParentName="DigitalStorage_LegacyBase">
    <defName>DigitalStorage_BufferWarehouse</defName>
    <label>缓冲仓库（3.0 遗留）</label>
    <description>3.0 的缓冲仓库。4.0 的容器本身就是真实 Thing，不再需要物理桥接层，这里只作为墓碑保留，没有功能。请拆除。</description>
    <graphicData>
      <texPath>2.0/基座</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <WorkToBuild>500</WorkToBuild>
      <Mass>10</Mass>
    </statBases>
    <costList>
      <Steel>100</Steel>
      <ComponentIndustrial>5</ComponentIndustrial>
    </costList>
  </ThingDef>

  <!-- 3.0 的终端芯片（物品）：4.0 砍掉，读档时作为无功能的遗物保留（可卖可扔） -->
  <ThingDef ParentName="ResourceBase">
    <defName>DigitalStorage_TerminalChip</defName>
    <label>终端芯片（3.0 遗留）</label>
    <description>3.0 的远程访问芯片。4.0 已不需要它（任何位置的殖民者都能直接存取），这里只作为墓碑保留，没有功能。</description>
    <graphicData>
      <texPath>2.0/基座</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <techLevel>Spacer</techLevel>
    <stackLimit>1</stackLimit>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <Mass>0.1</Mass>
      <MarketValue>1000</MarketValue>
      <DeteriorationRate>2</DeteriorationRate>
      <Flammability>0.2</Flammability>
    </statBases>
    <thingCategories>
      <li>BodyPartsBionic</li>
    </thingCategories>
    <tradeTags>
      <li>ExoticMisc</li>
    </tradeTags>
  </ThingDef>

  <!-- 3.0 的终端植入体（hediff）：读档时解析回来，随后由 Patch_AutoImplantBackpack 摘除并退回芯片 -->
  <HediffDef ParentName="ImplantHediffBase">
    <defName>DigitalStorage_TerminalImplant</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>终端植入体（3.0 遗留）</label>
    <labelNoun>终端植入体</labelNoun>
    <description>3.0 的神经植入体。4.0 已移除该机制，读档后会被自动摘除，并退回一枚终端芯片。</description>
    <spawnThingOnRemoved>DigitalStorage_TerminalChip</spawnThingOnRemoved>
    <keepOnBodyPartRestoration>false</keepOnBodyPartRestoration>
  </HediffDef>

  <!-- 3.0 的研究（4.0 砍掉）：墓碑保留，避免读档刷「找不到研究」。放在本页签视野外（负 Y） -->
  <ResearchProjectDef>
    <defName>DigitalStorage_Interface</defName>
    <label>数字存储接口（已废弃）</label>
    <description>3.0 的接口研究。4.0 已移除接口建筑，核心本身就是完全体。</description>
    <baseCost>2000</baseCost>
    <techLevel>Industrial</techLevel>
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
    <tab>DigitalStorage_Tab</tab>
    <researchViewX>6</researchViewX>
    <researchViewY>-3</researchViewY>
  </ResearchProjectDef>

  <ResearchProjectDef>
    <defName>DigitalStorage_TerminalImplant</defName>
    <label>终端植入体（已废弃）</label>
    <description>3.0 的芯片研究。4.0 是纯轮椅 —— 任何位置都能直接存取，不需要芯片。</description>
    <baseCost>3000</baseCost>
    <techLevel>Spacer</techLevel>
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
    <tab>DigitalStorage_Tab</tab>
    <researchViewX>7</researchViewX>
    <researchViewY>-3</researchViewY>
  </ResearchProjectDef>

  <ResearchProjectDef>
    <defName>DigitalStorage_BufferWarehouse</defName>
    <label>缓冲仓库（已废弃）</label>
    <description>3.0 的缓冲仓库研究。4.0 的容器本身就是真实 Thing。</description>
    <baseCost>1500</baseCost>
    <techLevel>Industrial</techLevel>
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
    <tab>DigitalStorage_Tab</tab>
    <researchViewX>8</researchViewX>
    <researchViewY>-3</researchViewY>
  </ResearchProjectDef>

  <!-- 3.0 的三条作业：墓碑保留，驱动指向 4.0 的同职责 driver。
       存档里若正好有 pawn 卡在这些 job 上，读档不会报「找不到 JobDef」；
       目标对不上时原版会自己判 Incompletable，不会卡死。 -->
  <JobDef>
    <defName>DigitalStorage_IngestToCore</defName>
    <driverClass>Verse.AI.JobDriver_HaulToContainer</driverClass>
    <reportString>把 TargetA 搬进 TargetB。</reportString>
  </JobDef>

  <JobDef>
    <defName>DigitalStorage_WithdrawToBill</defName>
    <driverClass>DigitalStorage.AI.JobDriver_DS_Withdraw</driverClass>
    <reportString>从数字存储取料。</reportString>
  </JobDef>

  <JobDef>
    <defName>DigitalStorage_ConsumeFromLedger</defName>
    <driverClass>DigitalStorage.AI.JobDriver_DS_Consume</driverClass>
    <reportString>从数字存储取用 TargetA。</reportString>
  </JobDef>

</Defs>
