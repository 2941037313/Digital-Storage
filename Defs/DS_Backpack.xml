<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    「背包」：挂在 pawn 身上的私有 ThingOwner（见 HediffComp_Backpack）。
    由 Patch_AutoImplantBackpack 自动植入每个殖民者 / 殖民地机械族，不是手术植入物。

    它的唯一用途：让"从核心取料"这一跳的 SpawnedParentOrMe 变成小人自己（0 距离），
    由 Patch_JobDriver_DoBill_LoadIngredients 在作业开始时按需放入。
    hediff 不显示、不 tick、无阶段，只当 comp 的载体。
  -->
  <HediffDef>
    <defName>DS_CoreBackpack</defName>
    <label>数字存储背包</label>
    <description>随身接入数字存储核心的接口。按需从核心取出本次作业所需的材料，用完归还核心，背包默认清空。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="DigitalStorage.Backpack.HediffCompProperties_Backpack">
        <!-- 最多容纳的堆数（软上限）：满了这一件就不取，退回原版"走到核心去拿"的老路。 -->
        <capacityStacks>8</capacityStacks>
      </li>
    </comps>
  </HediffDef>
</Defs>
