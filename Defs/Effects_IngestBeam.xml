<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    自动收纳的"收纳光束"（纯视觉物）。thingClass 是我们自己的 Mote 子类：
    光束消散的那一刻才真正把物品搬进核心，即"一阵光束后物品消失"。

    外观完全靠 DrawAt 里的 Graphics.DrawMesh 自绘（贴图/着色器都是原版打包资源
    Other/OrbitalBeam、Other/OrbitalBeamEnd），所以下面这个 graphicData
    只是为了满足 ThingDef 的校验，永远不会被画 —— texPath 给一个确定存在的原版贴图即可。
  -->
  <ThingDef ParentName="MoteBase">
    <defName>DS_IngestBeam</defName>
    <label>digital storage ingest beam</label>
    <thingClass>DigitalStorage.Effects.Mote_DS_IngestBeam</thingClass>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Things/Mote/AirPuff</texPath>
      <graphicClass>Graphic_Mote</graphicClass>
      <shaderType>MoteGlow</shaderType>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <mote>
      <fadeInTime>0</fadeInTime>
      <solidTime>1</solidTime>
      <fadeOutTime>0</fadeOutTime>
      <!-- lifespan 只是兜底：Mote_DS_IngestBeam 覆写了 EndOfLife => false，
           销毁时机由它自己的 Finish() 掌握。 -->
      <lifespan>120</lifespan>
    </mote>
  </ThingDef>
</Defs>
