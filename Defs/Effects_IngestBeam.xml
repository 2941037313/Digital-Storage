<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    自动收纳的"收纳光束"余像（纯视觉物，不做任何逻辑：物品在它出现之前就已经进核心了）。

    外观完全靠 DrawAt 里的 Graphics.DrawMesh 自绘（贴图/着色器都是原版打包资源
    Other/OrbitalBeam、Other/OrbitalBeamEnd），所以下面这个 graphicData
    只是为了满足 ThingDef 的校验，永远不会被画 —— texPath 给一个确定存在的原版贴图即可。

    时长与淡入淡出就在这里调：三者之**和**就是基类读的
    MoteProperties.Lifespan —— 它是只读计算属性（MoteProperties.cs:54
    `public float Lifespan => fadeInTime + solidTime + fadeOutTime;`），
    **不能**在 XML 里写 <lifespan>，否则启动即报
    "doesn't correspond to any field in type MoteProperties"。

    当前 0.1 + 0.4 + 0.25 = 0.75 秒 = 45 tick。
  -->
  <ThingDef ParentName="MoteBase">
    <defName>DS_IngestBeam</defName>
    <label>digital storage ingest beam</label>
    <thingClass>DigitalStorage.Effects.Mote_DS_IngestBeam</thingClass>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Things/Mote/AirPuff</texPath>
      <graphicClass>Graphic_Mote</graphicClass>
      <shaderType>MoteGlow</shaderType>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <mote>
      <fadeInTime>0.1</fadeInTime>
      <solidTime>0.4</solidTime>
      <fadeOutTime>0.25</fadeOutTime>
    </mote>
  </ThingDef>
</Defs>
