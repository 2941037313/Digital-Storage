  <!-- 基础数字存储研究 -->
  <ResearchProjectDef>
    <defName>DigitalStorage_BasicStorage</defName>
    <label>数字存储</label>
    <description>解锁基础数字存储系统。建造存储核心以创建远程物品存储网络。</description>
    <baseCost>1000</baseCost>
    <techLevel>Industrial</techLevel>
    <prerequisites>
      <li>MicroelectronicsBasics</li>
    </prerequisites>
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
    <tab>DigitalStorage_Tab</tab>
    <researchViewX>0</researchViewX>
    <researchViewY>2</researchViewY>
  </ResearchProjectDef>

  <!-- 4.0：数字存储接口研究已删（接口建筑砍掉，产品决策「核心一放就是完全体」）。 -->

  <!-- ==========================================================================
       核心容量阶梯：**挂研究，不挂建筑上的升级组件**（用户拍板）。
       Lv1 500 → Lv2 1000 → Lv3 1500 → Lv4 3000 栈，研究点数与目标上限同数。
       生效方式是 CoreTier 全局读研究 ⇒ 研究一完成，**地图上已有的核心立刻扩容**。
       X = 1/2/3 排一行放在最上面（Y = 6），不和任何既有链打架。
       ========================================================================== -->
  <ResearchProjectDef>
    <defName>DigitalStorage_CoreLevel2</defName>
    <label>核心 Lv2</label>
    <description>存储核心容量 500 → 1000 堆。\n\n对地图上**已经建好**的所有核心立即生效，不需要重建或重读档。</description>
    <baseCost>1000</baseCost>
    <techLevel>Spacer</techLevel>
    <prerequisites><li>DigitalStorage_BasicStorage</li></prerequisites>
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
    <tab>DigitalStorage_Tab</tab>
    <researchViewX>1</researchViewX>
    <researchViewY>6</researchViewY>
  </ResearchProjectDef>
