<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- 研究页签 -->
  <ResearchTabDef>
    <defName>DigitalStorage_Tab</defName>
    <label>数字存储</label>
  </ResearchTabDef>

  <!-- 基础数字存储研究 -->
  <ResearchProjectDef>
    <defName>DigitalStorage_BasicStorage</defName>
    <label>数字存储</label>
    <description>解锁基础数字存储系统。建造存储核心以创建远程物品存储网络。</description>
    <baseCost>1000</baseCost>
    <techLevel>Industrial</techLevel>
    <prerequisites>
      <li>MicroelectronicsBasics</li>
    </prerequisites>
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
    <tab>DigitalStorage_Tab</tab>
    <researchViewX>0</researchViewX>
    <researchViewY>2</researchViewY>
  </ResearchProjectDef>

  <!-- 4.0：数字存储接口研究已删（接口建筑砍掉，产品决策「核心一放就是完全体」）。
       原先依赖它的终端植入体研究与自动收纳 I 研究改为直接依赖基础数字存储。 -->

  <!-- 4.0：终端植入体研究已删（芯片整体砍除）。4.0 是纯轮椅 ——
       任何位置的殖民者都能直接存取，不需要任何 hediff / 建筑。 -->

  <!-- 自动收纳 1 级 -->
  <ResearchProjectDef>
    <defName>DigitalStorage_AutoIngest1</defName>
    <label>自动收纳 I</label>
    <description>解锁核心自动收纳功能。存储核心可直接吸收范围内的散落物品，无需殖民者搬运。</description>
    <baseCost>1000</baseCost>
    <techLevel>Spacer</techLevel>
    <prerequisites>
      <li>DigitalStorage_BasicStorage</li>
    </prerequisites>
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
    <tab>DigitalStorage_Tab</tab>
    <researchViewX>2</researchViewX>
    <researchViewY>2</researchViewY>
  </ResearchProjectDef>

  <!-- 自动收纳 2 级 -->
  <ResearchProjectDef>
    <defName>DigitalStorage_AutoIngest2</defName>
    <label>自动收纳 II</label>
    <description>提升自动收纳速度至每 15 tick 5 堆。</description>
    <baseCost>2000</baseCost>
    <techLevel>Spacer</techLevel>
    <prerequisites>
      <li>DigitalStorage_AutoIngest1</li>
    </prerequisites>
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
    <tab>DigitalStorage_Tab</tab>
    <researchViewX>2</researchViewX>
    <researchViewY>1</researchViewY>
  </ResearchProjectDef>

  <!-- 自动收纳 3 级 -->
  <ResearchProjectDef>
    <defName>DigitalStorage_AutoIngest3</defName>
    <label>自动收纳 III</label>
    <description>提升自动收纳速度至每 15 tick 10 堆。</description>
    <baseCost>3000</baseCost>
    <techLevel>Spacer</techLevel>
    <prerequisites>
      <li>DigitalStorage_AutoIngest2</li>
    </prerequisites>
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
    <tab>DigitalStorage_Tab</tab>
    <researchViewX>2</researchViewX>
    <researchViewY>0</researchViewY>
  </ResearchProjectDef>

  <!-- 4.0：缓冲仓库研究已删（缓冲仓库特性整体砍掉）。 -->

  <!-- 代理建筑 I（第一波：只解锁挖掘代理 I；二三级与其它三类随实现铺开） -->
  <ResearchProjectDef>
    <defName>DigitalStorage_Worker1</defName>
    <label>代理建筑 I</label>
    <description>解锁一级代理建筑。代理建筑由数字工人执行，能自动完成挖掘/建造/清洁/种植等工作，殖民者无需前往。</description>
    <baseCost>1000</baseCost>
    <techLevel>Spacer</techLevel>
    <prerequisites>
      <li>DigitalStorage_BasicStorage</li>
    </prerequisites>
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
    <tab>DigitalStorage_Tab</tab>
    <researchViewX>4</researchViewX>
    <researchViewY>2</researchViewY>
  </ResearchProjectDef>

</Defs>
