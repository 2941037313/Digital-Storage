  <!-- ==========================================================================
       制作代理链（4 级）—— 用户拍板：资质 5/10/15/20，速度 0.8/1/1.5/2，固定 300W。
       X = 4/5/6/7、Y = 7 排成一行（其余内容最高用到 Y=6，不打架）。
       建筑本体见 Defs/ThingDefs_CraftWorkers.xml（1×1，扫描 13×13 方形）。
       ========================================================================== -->
  <ResearchProjectDef>
    <defName>DigitalStorage_CraftProxy1</defName>
    <label>制作代理 I</label>
    <description>解锁一级制作代理：13×13 范围内工作台能做的配方由建筑自己完成（在「制作自动化」面板里下单，台子上不需要建有 bill）—— 材料从数字存储核心扣除，产物直接存入核心。\n\n资质 5 级，速度 0.8×，自身耗电 300W（另加范围内各工作台的耗电）。</description>
    <baseCost>1000</baseCost>
    <techLevel>Spacer</techLevel>
    <prerequisites><li>DigitalStorage_BasicStorage</li></prerequisites>
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
    <tab>DigitalStorage_Tab</tab>
    <researchViewX>4</researchViewX>
    <researchViewY>7</researchViewY>
  </ResearchProjectDef>
