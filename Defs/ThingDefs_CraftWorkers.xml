    </statBases>
    <tickerType>Normal</tickerType>
    <costList>
      <Steel>600</Steel>
      <Plasteel>100</Plasteel>
      <ComponentIndustrial>30</ComponentIndustrial>
      <ComponentSpacer>12</ComponentSpacer>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>300</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
    </comps>
  </ThingDef>

  <!-- ==========================================================================
       具体建筑（4 个）。贴图暂时沿用现有"代理建筑"底图，1×1 缩放显示；
       以后有了专用美术，只改 <texPath> 即可（drawSize 保持 (1,1)）。
       ========================================================================== -->

  <ThingDef ParentName="DigitalStorage_CraftTierI">
    <defName>DigitalStorage_WorkerCraftI</defName>
    <researchPrerequisites>
      <li>DigitalStorage_CraftProxy1</li>
    </researchPrerequisites>
    <label>制作代理 I</label>
    <description>自动完成 13×13 范围内工作台上的 bill：材料从数字存储核心扣除，产物直接存入核心，殖民者无需动腿。断电即停工。</description>
    <graphicData>
      <texPath>2.0/代理建筑</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <uiIconScale>0.9</uiIconScale>
    <fillPercent>0.4</fillPercent>
    <inspectorTabs>
      <li>DigitalStorage.UI.ITab_BillAutomation</li>
    </inspectorTabs>
    <comps>
      <li Class="DigitalStorage.Components.CompProperties_BillAutomation">
        <skillLevel>5</skillLevel>
        <workSpeedMult>0.8</workSpeedMult>
      </li>
    </comps>
  </ThingDef>

