<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ==========================================================================
       制作代理（4 级）—— 由建筑自己把范围内工作台上的 bill 做掉，殖民者不参与。

       用户拍板：
         · 资质 5 / 10 / 15 / 20，速度 0.8 / 1 / 1.5 / 2，**升级不增耗电**（自身固定 300W）
         · 建筑 1×1（方便在一个 13×13 扫描范围里塞尽量多工作台）
         · 产物直塞核心；材料只从核心容器取；台子断电/缺燃料就停

       ⚠️ 两个 Def-XML 硬校验（与 ThingDefs_Workers.xml 同一套）：
         ① ThingDef 的 defName **不能以数字结尾** ⇒ 等级用罗马数字 I~IV
            （ResearchProjectDef 无此限制，研究仍用 CraftProxy1/2/3/4）；
         ② drawSize/drawOffset 属于 <graphicData>；1×1 建筑**不要**抄 2×2 的贴图偏移。

       耗电口径（CompBillAutomation）：自身 300W + Σ范围内台子耗电（没电力组件的台子按 100W 折算），
       再乘超频倍率。台子自己的电**照交**（不豁免）。
       扫描范围 = 以建筑为中心的 13×13 方形（半边长 6），见 CompProperties_BillAutomation.scanRadius。
       ========================================================================== -->

  <!-- ===== 等级 I：资质 5、速度 0.8× ===== -->
  <ThingDef Name="DigitalStorage_CraftTierI" ParentName="DigitalStorage_BuildingBase" Abstract="True">
    <label>制作代理 I</label>
    <description>数字制作单元（一级）。资质 5 级，速度 0.8×。</description>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>600</MaxHitPoints>
      <WorkToBuild>600</WorkToBuild>
      <Mass>20</Mass>
    </statBases>
    <tickerType>Normal</tickerType>
    <costList>
      <Steel>200</Steel>
      <ComponentIndustrial>6</ComponentIndustrial>
      <ComponentSpacer>1</ComponentSpacer>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>300</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
    </comps>
  </ThingDef>

