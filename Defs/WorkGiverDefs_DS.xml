<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- 阶段 4.1：搬运 → 核心（优先级高于 HaulGeneral=15） -->
  <WorkGiverDef>
    <defName>DigitalStorage_HaulToCore</defName>
    <label>把物品送入数字存储核心</label>
    <giverClass>DigitalStorage.AI.WorkGiver_DS_HaulToCore</giverClass>
    <workType>Hauling</workType>
    <verb>搬运</verb>
    <gerund>搬运中</gerund>
    <priorityInType>50</priorityInType>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

  <!-- 阶段 4.2：从核心取料做 bill（priorityInType=999 抢在所有 DoBillsXxx 前）-->
  <WorkGiverDef>
    <defName>DigitalStorage_WithdrawForBill</defName>
    <label>从数字存储核心取料做工</label>
    <giverClass>DigitalStorage.AI.WorkGiver_DS_WithdrawForBill</giverClass>
    <workType>Crafting</workType>
    <verb>做</verb>
    <gerund>做工中</gerund>
    <priorityInType>999</priorityInType>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

</Defs>
