<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- 阶段 4.1：进核心方向的 Job -->
  <JobDef>
    <defName>DigitalStorage_IngestToCore</defName>
    <driverClass>DigitalStorage.AI.JobDriver_DS_Ingest</driverClass>
    <reportString>把 TargetA 送入数字存储核心。</reportString>
  </JobDef>

  <!-- 阶段 4.2：从核心取料做 bill -->
  <JobDef>
    <defName>DigitalStorage_WithdrawToBill</defName>
    <driverClass>DigitalStorage.AI.JobDriver_DS_WithdrawForBill</driverClass>
    <reportString>从数字存储核心取料为 TargetA 做工。</reportString>
  </JobDef>

  <!-- 阶段 4.3：从核心取料送蓝图/Frame -->
  <JobDef>
    <defName>DigitalStorage_WithdrawToConstruction</defName>
    <driverClass>DigitalStorage.AI.JobDriver_DS_Withdraw</driverClass>
    <reportString>从数字存储核心取料送去 TargetA。</reportString>
  </JobDef>

  <!-- 阶段 4.4：右键强制取料到指定格 -->
  <JobDef>
    <defName>DigitalStorage_WithdrawToSpot</defName>
    <driverClass>DigitalStorage.AI.JobDriver_DS_Withdraw</driverClass>
    <reportString>从数字存储核心取料到指定位置。</reportString>
  </JobDef>

  <!-- 阶段 4.6：从核心取消耗品直接进嘴 -->
  <JobDef>
    <defName>DigitalStorage_ConsumeFromLedger</defName>
    <driverClass>DigitalStorage.AI.JobDriver_DS_Consume</driverClass>
    <reportString>从数字存储核心取用 TargetA。</reportString>
  </JobDef>

</Defs>
