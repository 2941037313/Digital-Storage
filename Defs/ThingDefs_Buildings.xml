<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- 数字存储建筑基类 -->
  <ThingDef Name="DigitalStorage_BuildingBase" ParentName="BuildingBase" Abstract="True">
    <designationCategory>Furniture</designationCategory>
    <passability>PassThroughOnly</passability>
    <castEdgeShadows>true</castEdgeShadows>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <drawGUIOverlay>true</drawGUIOverlay>
    <surfaceType>Item</surfaceType>
    <minifiedDef>MinifiedThing</minifiedDef>
    <statBases>
      <Flammability>0.5</Flammability>
    </statBases>
    <comps>
      <li Class="CompProperties_Forbiddable" />
    </comps>
    <thingCategories>
      <li>BuildingsFurniture</li>
    </thingCategories>
  </ThingDef>

  <!-- 存储核心 - 每个核心是独立网络 -->
  <ThingDef ParentName="DigitalStorage_BuildingBase">
    <defName>DigitalStorage_StorageCore</defName>
    <label>数字存储核心</label>
    <description>数字存储系统的核心单元。物品直接存放在核心内部，不占地图空间，也不会老化或变质。\n\n任何位置的殖民者都可以从中取用物品，无需走到核心旁边。</description>
    <thingClass>DigitalStorage.Components.Building_StorageCore</thingClass>
    <graphicData>
      <texPath>2.0/基座</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(4,4)</drawSize>
      <drawOffset>(0, 0, 0.5)</drawOffset>
      <drawRotated>false</drawRotated>
    </graphicData>
    <building>
      <isEdifice>false</isEdifice>
    </building>
    <drawerType>MapMeshAndRealTime</drawerType>
    <uiIconScale>0.9</uiIconScale>
    <fillPercent>0.5</fillPercent>
    <statBases>
      <MaxHitPoints>100000</MaxHitPoints>
      <WorkToBuild>2000</WorkToBuild>
      <Mass>50</Mass>
    </statBases>
    <size>(3,3)</size>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0, 0, -2)</interactionCellOffset>
    <inspectorTabs>
      <li>DigitalStorage.UI.ITab_DigitalStorage</li>
    </inspectorTabs>
    <tickerType>Normal</tickerType>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>100</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Breakdownable" />
      <li Class="DigitalStorage.Components.CompProperties_AutoIngest" />
      <!-- 4.0：升级三件套已删（CompStorageCoreUpgrade / CompProperties_StorageCoreUpgrade /
           StorageCoreUpgrade）。用户拍板「核心一放就是完全体」，容量固定为实体上的 maxStacks。
           原先这里的 <upgrades> 1~4 级（100/250/500/1000 组）随之作废。 -->
    </comps>
    <researchPrerequisites>
      <li>DigitalStorage_BasicStorage</li>
    </researchPrerequisites>
    <costList>
      <Steel>500</Steel>
      <Plasteel>250</Plasteel>
      <ComponentSpacer>15</ComponentSpacer>
      <ComponentIndustrial>100</ComponentIndustrial>
    </costList>
  </ThingDef>

  <!-- 4.0：输入接口建筑已删（产品决策「砍接口建筑：核心一放就是完全体」）。
       原先的「代理点 / 走接口取物」机制随之作废，改为纯轮椅（任何位置隔空存取）。 -->

  <!-- 4.0：缓冲仓库特性已整体删除（用户拍板"砍掉"）。
       它当初是"物理存储桥接层"——因为账本里的东西不是真 Thing，
       需要一个真实存在、兼容所有 mod 的 SlotGroup 建筑来做桥梁。
       4.0 的容器本身就是真实 Thing，桥不再需要。
       同批删除：Building_BufferWarehouse(+_UI) / CompBufferWarehouse /
       CompProperties_BufferWarehouse / BufferWarehouseUtility /
       BufferWarehouseJobHelper / ITab_BufferWarehouse / Patch_BufferWarehouse。 -->

</Defs>
