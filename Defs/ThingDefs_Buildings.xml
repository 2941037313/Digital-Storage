<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- 数字存储建筑基类 -->
  <ThingDef Name="DigitalStorage_BuildingBase" ParentName="BuildingBase" Abstract="True">
    <designationCategory>Furniture</designationCategory>
    <passability>PassThroughOnly</passability>
    <castEdgeShadows>true</castEdgeShadows>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <drawGUIOverlay>true</drawGUIOverlay>
    <surfaceType>Item</surfaceType>
    <minifiedDef>MinifiedThing</minifiedDef>
    <statBases>
      <Flammability>0.5</Flammability>
    </statBases>
    <comps>
      <li Class="CompProperties_Forbiddable" />
    </comps>
    <thingCategories>
      <li>BuildingsFurniture</li>
    </thingCategories>
  </ThingDef>

  <!-- 存储核心 - 每个核心是独立网络 -->
  <ThingDef ParentName="DigitalStorage_BuildingBase">
    <defName>DigitalStorage_StorageCore</defName>
    <label>数字存储核心</label>
    <description>数字存储系统的核心单元。每个核心是一个独立的虚拟存储网络，可以命名。\n\n物品通过输入接口送入后转为数字数据，不占地图空间，也不会老化或变质。\n\n装载终端芯片的殖民者可以无需走到接口直接存取。</description>
    <thingClass>DigitalStorage.Components.Building_StorageCore</thingClass>
    <graphicData>
      <texPath>2.0/基座</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(4,4)</drawSize>
      <drawOffset>(0, 0, 0.5)</drawOffset>
    </graphicData>
    <drawerType>MapMeshAndRealTime</drawerType>
    <uiIconScale>0.9</uiIconScale>
    <fillPercent>0.5</fillPercent>
    <statBases>
      <MaxHitPoints>100000</MaxHitPoints>
      <WorkToBuild>2000</WorkToBuild>
      <Mass>50</Mass>
    </statBases>
    <size>(3,3)</size>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0, 0, -2)</interactionCellOffset>
    <inspectorTabs>
      <li>DigitalStorage.UI.ITab_DigitalStorage</li>
    </inspectorTabs>
    <tickerType>Normal</tickerType>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>100</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Breakdownable" />
      <li Class="DigitalStorage.Components.CompProperties_StorageCoreUpgrade">
        <upgrades>
          <!-- 等级 1: 基础 -->
          <li>
            <labelKey>DS_UpgradeLevel_1</labelKey>
            <capacity>100</capacity>
            <powerConsumption>100</powerConsumption>
            <upgradeDurationTicks>0</upgradeDurationTicks>
            <cooldownTicks>0</cooldownTicks>
          </li>
          <!-- 等级 2: 进阶 -->
          <li>
            <labelKey>DS_UpgradeLevel_2</labelKey>
            <capacity>250</capacity>
            <powerConsumption>150</powerConsumption>
            <upgradeDurationTicks>30000</upgradeDurationTicks>
            <cooldownTicks>2500</cooldownTicks>
            <upgradeCost>
              <li>
                <thingDef>Steel</thingDef>
                <count>200</count>
              </li>
              <li>
                <thingDef>ComponentIndustrial</thingDef>
                <count>10</count>
              </li>
            </upgradeCost>
          </li>
          <!-- 等级 3: 高级 -->
          <li>
            <labelKey>DS_UpgradeLevel_3</labelKey>
            <capacity>500</capacity>
            <powerConsumption>200</powerConsumption>
            <upgradeDurationTicks>60000</upgradeDurationTicks>
            <cooldownTicks>2500</cooldownTicks>
            <upgradeCost>
              <li>
                <thingDef>Plasteel</thingDef>
                <count>100</count>
              </li>
              <li>
                <thingDef>ComponentIndustrial</thingDef>
                <count>20</count>
              </li>
              <li>
                <thingDef>ComponentSpacer</thingDef>
                <count>5</count>
              </li>
            </upgradeCost>
          </li>
          <!-- 等级 4: 量子 -->
          <li>
            <labelKey>DS_UpgradeLevel_4</labelKey>
            <capacity>1000</capacity>
            <powerConsumption>300</powerConsumption>
            <upgradeDurationTicks>120000</upgradeDurationTicks>
            <cooldownTicks>2500</cooldownTicks>
            <upgradeCost>
              <li>
                <thingDef>Plasteel</thingDef>
                <count>200</count>
              </li>
              <li>
                <thingDef>ComponentSpacer</thingDef>
                <count>15</count>
              </li>
            </upgradeCost>
          </li>
        </upgrades>
      </li>
    </comps>
    <researchPrerequisites>
      <li>DigitalStorage_BasicStorage</li>
    </researchPrerequisites>
    <costList>
      <Steel>500</Steel>
      <Plasteel>250</Plasteel>
      <ComponentSpacer>15</ComponentSpacer>
      <ComponentIndustrial>100</ComponentIndustrial>
    </costList>
  </ThingDef>

  <!-- 输入接口 - 物品放上去自动传送到核心 -->
  <ThingDef ParentName="DigitalStorage_BuildingBase">
    <defName>DigitalStorage_InputInterface</defName>
    <label>数字存储接口</label>
    <description>数字存储系统的接入点。殖民者可以走到这里存取核心网络中的物品。\n\n可手动选择连接目标核心，支持跨地图连接。</description>
    <thingClass>DigitalStorage.Components.Building_InputInterface</thingClass>
    <graphicData>
      <texPath>接口</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <uiIconScale>0.9</uiIconScale>
    <fillPercent>0.4</fillPercent>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <WorkToBuild>1000</WorkToBuild>
      <Mass>20</Mass>
    </statBases>
    <size>(1,1)</size>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>50</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
    </comps>
    <researchPrerequisites>
      <li>DigitalStorage_Interface</li>
    </researchPrerequisites>
    <costList>
      <Steel>50</Steel>
      <Plasteel>25</Plasteel>
      <ComponentIndustrial>5</ComponentIndustrial>
    </costList>
  </ThingDef>

</Defs>
