<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- 数字存储建筑基类 -->
  <ThingDef Name="DigitalStorage_BuildingBase" ParentName="BuildingBase" Abstract="True">
    <designationCategory>Furniture</designationCategory>
    <passability>PassThroughOnly</passability>
    <castEdgeShadows>true</castEdgeShadows>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <drawGUIOverlay>true</drawGUIOverlay>
    <surfaceType>Item</surfaceType>
    <minifiedDef>MinifiedThing</minifiedDef>
    <statBases>
      <Flammability>0.5</Flammability>
    </statBases>
    <comps>
      <li Class="CompProperties_Forbiddable" />
    </comps>
    <thingCategories>
      <li>BuildingsFurniture</li>
    </thingCategories>
  </ThingDef>

  <!-- 存储核心 - 每个核心是独立网络 -->
  <ThingDef ParentName="DigitalStorage_BuildingBase">
    <defName>DigitalStorage_StorageCore</defName>
    <label>数字存储核心</label>
    <description>数字存储系统的核心单元。每个核心是一个独立的虚拟存储网络，可以命名。\n\n物品通过输入接口送入后转为数字数据，不占地图空间，也不会老化或变质。\n\n装载终端芯片的殖民者可以无需走到接口直接存取。</description>
    <thingClass>DigitalStorage.Components.Building_StorageCore</thingClass>
    <graphicData>
      <texPath>2.0/基座</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(4,4)</drawSize>
      <drawOffset>(0, 0, 0.5)</drawOffset>
      <drawRotated>false</drawRotated>
    </graphicData>
    <building>
      <isEdifice>false</isEdifice>
    </building>
    <drawerType>MapMeshAndRealTime</drawerType>
    <uiIconScale>0.9</uiIconScale>
    <fillPercent>0.5</fillPercent>
    <statBases>
      <MaxHitPoints>100000</MaxHitPoints>
      <WorkToBuild>2000</WorkToBuild>
      <Mass>50</Mass>
    </statBases>
    <size>(3,3)</size>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0, 0, -2)</interactionCellOffset>
    <inspectorTabs>
      <li>DigitalStorage.UI.ITab_DigitalStorage</li>
    </inspectorTabs>
    <tickerType>Normal</tickerType>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>100</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Breakdownable" />
      <li Class="DigitalStorage.Components.CompProperties_AutoIngest" />
      <li Class="DigitalStorage.Components.CompProperties_StorageCoreUpgrade">
        <upgrades>
          <!-- 等级 1: 基础 -->
          <li>
            <labelKey>DS_UpgradeLevel_1</labelKey>
            <capacity>100</capacity>
            <powerConsumption>100</powerConsumption>
            <upgradeDurationTicks>0</upgradeDurationTicks>
            <cooldownTicks>0</cooldownTicks>
          </li>
          <!-- 等级 2: 进阶 -->
          <li>
            <labelKey>DS_UpgradeLevel_2</labelKey>
            <capacity>250</capacity>
            <powerConsumption>150</powerConsumption>
            <upgradeDurationTicks>30000</upgradeDurationTicks>
            <cooldownTicks>2500</cooldownTicks>
            <upgradeCost>
              <li>
                <thingDef>Steel</thingDef>
                <count>200</count>
              </li>
              <li>
                <thingDef>ComponentIndustrial</thingDef>
                <count>10</count>
              </li>
            </upgradeCost>
          </li>
          <!-- 等级 3: 高级 -->
          <li>
            <labelKey>DS_UpgradeLevel_3</labelKey>
            <capacity>500</capacity>
            <powerConsumption>200</powerConsumption>
            <upgradeDurationTicks>60000</upgradeDurationTicks>
            <cooldownTicks>2500</cooldownTicks>
            <upgradeCost>
              <li>
                <thingDef>Plasteel</thingDef>
                <count>100</count>
              </li>
              <li>
                <thingDef>ComponentIndustrial</thingDef>
                <count>20</count>
              </li>
              <li>
                <thingDef>ComponentSpacer</thingDef>
                <count>5</count>
              </li>
            </upgradeCost>
          </li>
          <!-- 等级 4: 量子 -->
          <li>
            <labelKey>DS_UpgradeLevel_4</labelKey>
            <capacity>1000</capacity>
            <powerConsumption>300</powerConsumption>
            <upgradeDurationTicks>120000</upgradeDurationTicks>
            <cooldownTicks>2500</cooldownTicks>
            <upgradeCost>
              <li>
                <thingDef>Plasteel</thingDef>
                <count>200</count>
              </li>
              <li>
                <thingDef>ComponentSpacer</thingDef>
                <count>15</count>
              </li>
            </upgradeCost>
          </li>
        </upgrades>
      </li>
    </comps>
    <researchPrerequisites>
      <li>DigitalStorage_BasicStorage</li>
    </researchPrerequisites>
    <costList>
      <Steel>500</Steel>
      <Plasteel>250</Plasteel>
      <ComponentSpacer>15</ComponentSpacer>
      <ComponentIndustrial>100</ComponentIndustrial>
    </costList>
  </ThingDef>

  <!-- 输入接口 - 物品放上去自动传送到核心 -->
  <ThingDef ParentName="DigitalStorage_BuildingBase">
    <defName>DigitalStorage_InputInterface</defName>
    <label>数字存储接口</label>
    <description>数字存储系统的接入点。殖民者可以走到这里存取核心网络中的物品。\n\n可手动选择连接目标核心，支持跨地图连接。</description>
    <thingClass>DigitalStorage.Components.Building_InputInterface</thingClass>
    <graphicData>
      <texPath>接口</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <uiIconScale>0.9</uiIconScale>
    <fillPercent>0.4</fillPercent>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <WorkToBuild>1000</WorkToBuild>
      <Mass>20</Mass>
    </statBases>
    <size>(1,1)</size>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>50</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
    </comps>
    <researchPrerequisites>
      <li>DigitalStorage_Interface</li>
    </researchPrerequisites>
    <costList>
      <Steel>50</Steel>
      <Plasteel>25</Plasteel>
      <ComponentIndustrial>5</ComponentIndustrial>
    </costList>
  </ThingDef>

  <!-- 缓冲仓库 —— 物理存储桥接层，物品在 SlotGroup 真实存在，兼容所有 mod -->
  <ThingDef ParentName="BuildingBase">
    <defName>DigitalStorage_BufferWarehouse</defName>
    <label>缓冲仓库</label>
    <description>数字存储系统的物理缓冲区。物品在此真实存在，兼容所有 mod。自动从绑定核心补货，超额物品自动收纳。</description>
    <thingClass>DigitalStorage.Components.Building_BufferWarehouse</thingClass>
    <graphicData>
      <texPath>缓冲仓库</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.5,1.5)</drawSize>
    </graphicData>
    <uiIconScale>1</uiIconScale>
    <size>(1,1)</size>
    <designationCategory>Furniture</designationCategory>
    <passability>PassThroughOnly</passability>
    <surfaceType>Item</surfaceType>
    <drawGUIOverlay>true</drawGUIOverlay>
    <castEdgeShadows>true</castEdgeShadows>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <minifiedDef>MinifiedThing</minifiedDef>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <WorkToBuild>500</WorkToBuild>
      <Mass>10</Mass>
      <Flammability>0.5</Flammability>
    </statBases>
    <fillPercent>0.8</fillPercent>
    <tickerType>Normal</tickerType>
    <building>
      <maxItemsInCell>999</maxItemsInCell>
      <preventDeteriorationOnTop>true</preventDeteriorationOnTop>
      <ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
      <defaultStorageSettings>
        <filter>
          <disallowNotEverStorable>true</disallowNotEverStorable>
          <categories /> <!-- 默认不允任何种类——由自动锁定物品时 check filter -->
        </filter>
      </defaultStorageSettings>
    </building>
    <inspectorTabs>
      <!-- 8.1: 原版 ITab_Storage 已移除（那是筛选/优先级的改动入口）——
           缓冲仓库的设置唯一入口是下方的新 UI tab -->
      <li>DigitalStorage.UI.ITab_BufferWarehouse</li>
    </inspectorTabs>
    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li Class="DigitalStorage.Components.CompProperties_BufferWarehouse" />
    </comps>
    <thingCategories>
      <li>BuildingsFurniture</li>
    </thingCategories>
    <researchPrerequisites>
      <li>DigitalStorage_BufferWarehouse</li>
    </researchPrerequisites>
    <costList>
      <Steel>100</Steel>
      <ComponentIndustrial>5</ComponentIndustrial>
    </costList>
  </ThingDef>

</Defs>
