  <!-- 超凡代理：四条链的终点。一台建筑同时接管四类工作。
       速度 5.0×、资质 20、**每类并行 50 / 合计 200**、耗电 6000W。 -->
  <ThingDef ParentName="DigitalStorage_BuildingBase">
    <defName>DigitalStorage_WorkerTranscendent</defName>
    <label>超凡代理</label>
    <description>四条代理链的终点。一台建筑同时接管挖掘、建造、清洁、种植（含伐木）。\n\n速度 7.5×，资质 20 级，每类工作可并行 75 件（四类合计上限 300），耗电 6000W。</description>
    <size>(3,3)</size>
    <statBases>
      <MaxHitPoints>5000</MaxHitPoints>
      <WorkToBuild>6000</WorkToBuild>
      <Mass>80</Mass>
    </statBases>
    <tickerType>Normal</tickerType>
    <researchPrerequisites>
      <li>DigitalStorage_TranscendentProxy</li>
    </researchPrerequisites>
    <costList>
      <Steel>2250</Steel>
      <Plasteel>900</Plasteel>
      <ComponentIndustrial>120</ComponentIndustrial>
      <ComponentSpacer>60</ComponentSpacer>
    </costList>
    <graphicData>
      <texPath>2.0/代理建筑-超凡</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <uiIconScale>0.9</uiIconScale>
    <fillPercent>0.5</fillPercent>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>6000</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="DigitalStorage.Components.CompProperties_DigitalWorker">
        <workTypes>
          <li>Mining</li>
          <li>Construction</li>
          <li>Cleaning</li>
          <li>Growing</li>
          <li>PlantCutting</li>
        </workTypes>
        <skillLevel>20</skillLevel>
        <workSpeedMult>7.5</workSpeedMult>
        <maxParallelPerWorkType>75</maxParallelPerWorkType>
        <maxParallelTotal>300</maxParallelTotal>
        <maxVisualTasks>12</maxVisualTasks>
      </li>
    </comps>
  </ThingDef>
</Defs>
