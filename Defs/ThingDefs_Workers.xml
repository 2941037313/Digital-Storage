<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ==========================================================================
       代理建筑（数字工人）：每类 job 一个专用建筑，每类三级。
       第一波只做「挖掘代理 I」验证最小闭环；二三级与其它三类按同一模板铺开
       （等级差异只有：技能资质 / 速度倍率 / 耗电 / 造价 / 工时）。

       出处与机制见 Docs\实现方案-job自动化.md：
         速度倍率是速度的唯一来源（不乘 pawn.GetStatValue）；
         技能资质只用于品质与产量。

       ⚠️ 两个 Def-XML 硬校验（已踩）：
         ① **ThingDef 的 defName 不能以数字结尾**（ThingDef.ConfigErrors）——
            否则它自己 + 自动生成的 Blueprint_/Frame_/Blueprint_Install_ 一起报 Config error。
            所以等级用罗马数字 I/II/III（ResearchProjectDef 无此限制，仍用 1/2/3）。
         ② **drawSize / drawOffset 属于 <graphicData>**，写成 ThingDef 的直接子节点会
            "doesn't correspond to any field in type ThingDef"。
       ========================================================================== -->

  <!-- 等级 I 的抽象父级：放"等级相关"的东西（造价 / 耗电 / HP / 工时） -->
  <ThingDef Name="DigitalStorage_WorkerTierI" ParentName="DigitalStorage_BuildingBase" Abstract="True">
    <label>代理建筑 I</label>
    <description>数字工人的执行单元（一级）。速度 0.8×，资质 8 级。</description>
    <size>(2,2)</size>
    <statBases>
      <MaxHitPoints>1000</MaxHitPoints>
      <WorkToBuild>800</WorkToBuild>
      <Mass>30</Mass>
    </statBases>
    <tickerType>Normal</tickerType>
    <researchPrerequisites>
      <li>DigitalStorage_Worker1</li>
    </researchPrerequisites>
    <costList>
      <Steel>200</Steel>
      <ComponentIndustrial>6</ComponentIndustrial>
      <ComponentSpacer>1</ComponentSpacer>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>500</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
    </comps>
  </ThingDef>

  <!-- 挖掘代理 I -->
  <ThingDef ParentName="DigitalStorage_WorkerTierI">
    <defName>DigitalStorage_WorkerMiningI</defName>
    <label>挖掘代理 I</label>
    <description>自动完成玩家标记的采矿工作，殖民者无需前往。\n\n只处理已经在核心网络里、或被自动收纳吸走的产物。断电即停工。</description>
    <graphicData>
      <texPath>2.0/代理建筑</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(2,2)</drawSize>
      <drawOffset>(0, 0, 0.5)</drawOffset>
      <drawRotated>false</drawRotated>
    </graphicData>
    <uiIconScale>0.9</uiIconScale>
    <fillPercent>0.5</fillPercent>
    <comps>
      <li Class="DigitalStorage.Components.CompProperties_DigitalWorker">
        <workType>Mining</workType>
        <skillLevel>8</skillLevel>
        <workSpeedMult>0.8</workSpeedMult>
      </li>
    </comps>
  </ThingDef>

</Defs>
