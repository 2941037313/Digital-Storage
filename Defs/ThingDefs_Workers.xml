<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ==========================================================================
       代理建筑（数字工人）：每类 job 一个专用建筑，每类三级 ⇒ 4 × 3 = 12 个。
       结构：3 个**抽象等级父级**（放等级相关：造价/耗电/HP/工时/研究/技能/速度）
           + 12 个具体 def（放职业相关：标签/描述/贴图/workTypes）。

       ⚠️ 两个 Def-XML 硬校验（已踩，见 obsidian 代码Wiki/rimworld/Def-XML-硬校验.md）：
         ① ThingDef 的 defName **不能以数字结尾** ⇒ 等级用罗马数字 I/II/III
            （ResearchProjectDef 无此限制，研究仍用 Worker1/2/3）。
         ② drawSize/drawOffset 属于 <graphicData>；且 **drawOffset 不要跨尺寸抄**
            （核心那条 (0,0,0.5) 是给 3×3 建筑配 4×4 贴图用的，抄到 2×2 会让图偏北半格）。

       "种植"在游戏里是两个 WorkTypeDef（Growing 播种/收割、PlantCutting 伐木），
       用户把伐木归进种植 ⇒ 种植代理的 workTypes 同时列这两个。
       当前已实现：Mining / Construction / Cleaning / PlantCutting；
       Growing 的播种与收割是 scanCells 型 WorkGiver，需要格子型目标管线，下一波接。
       ========================================================================== -->

  <!-- ===== 等级 I ===== -->
  <ThingDef Name="DigitalStorage_WorkerTierI" ParentName="DigitalStorage_BuildingBase" Abstract="True">
    <label>代理建筑 I</label>
    <description>数字工人的执行单元（一级）。速度 0.8×，资质 8 级。</description>
    <size>(2,2)</size>
    <statBases>
      <MaxHitPoints>1000</MaxHitPoints>
      <WorkToBuild>800</WorkToBuild>
      <Mass>30</Mass>
    </statBases>
    <tickerType>Normal</tickerType>
    <costList>
      <Steel>200</Steel>
      <ComponentIndustrial>6</ComponentIndustrial>
      <ComponentSpacer>1</ComponentSpacer>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>500</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
    </comps>
  </ThingDef>

